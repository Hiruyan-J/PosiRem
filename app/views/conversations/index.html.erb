<%= content_for :title, "チャット画面" %>

<% if user_signed_in? %>
  <%= turbo_stream_from "user_#{current_user.id}" %>
<% end %>

<div class="container mx-auto p-4">
  <div class="chat-container bg-base-100 p-6 rounded-box shadow-lg max-w-2xl mx-auto">
    <% if @conversations.any? %>
      <div id="chat-messages" class="overflow-y-auto max-h-[60vh] mb-4 p-4 space-y-4">
        <% @conversations.each do |conversation| %>
          <%# ユーザーの入力 %>
          <%= render "user_message", conversation: conversation %>
          <%# AIの回答 %>
          <% if conversation.suggestions.any? %>
            <%= render "ai_response", conversation: conversation %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="chat chat-start">
        <div class="chat-bubble chat-bubble-secondary text-secondary-content">
          <p>お子さまへの注意の言葉を、テキストボックスに入力してください。</p>
          <p>入力いただいた言葉を、ポジティブでやさしい表現に変換して、いくつか候補をご提案します。</p>
          <div>
            <p>たとえば：</p>
            <ul class="list-disc list-inside ml-4">
              <li>走らないで → ゆっくり歩こうね</li>
              <li>テレビを触らないで → 見るだけにしようね</li>
            </ul>
          </div>
          <p>または、今の状況を教えていただくと、その場に合ったやさしい言葉に言い換えることもできます。</p>
        </div>
      </div>
    <% end %>

    <%# 入力フォーム %>
    <div id="conversation-form" class="mt-4">
      <%= render 'conversations/form', conversation: @conversation %>
    </div>
  </div>
</div>
