<%= content_for :title, "チャット画面" %>

<% if user_signed_in? %>
  <%= turbo_stream_from "user_#{current_user.id}" %>
<% end %>

<%= render 'shared/ai_error_messages', error_message: nil %>

<div class="container mx-auto p-4">
  <div class="chat-container bg-base-100 p-6 rounded-box shadow-lg max-w-2xl mx-auto">
    <% if @conversations.any? %>
      <%# チャットメッセージ一覧 %>
      <div id="chat-messages"
            data-controller="infinite-scroll"
            data-infinite-scroll-url-value="<%= conversations_path %>"
            data-infinite-scroll-target="scrollContainer"
            style="overflow-anchor: none;"
            class="overflow-y-auto max-h-[55vh] md:max-h-[60vh] mb-4 p-4 space-y-4">

        <%# 無限スクロール監視ポイント %>
        <div id="infinite-scroll-target" data-infinite-scroll-target="sentinel">
          <p class="text-center text-xs text-gray-500">読み込み中…</p>  <%# TODO:デバッグコード削除 %>
        </div>

        <% @conversations.each do |conversation| %>
          <p>html</p>  <%# TODO:デバッグコード削除 %>
          <%= conversation.id %>  <%# TODO:デバッグコード削除 %>
          <%= render "conversation", conversation: conversation %>
        <% end %>
      </div>

    <% else %>
      <%# 初期説明メッセージ %>
      <div class="chat chat-start">
        <div class="chat-bubble chat-bubble-secondary text-secondary-content">
          <p>お子さまへの注意の言葉を、テキストボックスに入力してください。</p>
          <p>入力いただいた言葉を、ポジティブでやさしい表現に変換して、いくつか候補をご提案します。</p>
          <div>
            <p>たとえば：</p>
            <ul class="list-disc list-inside ml-4">
              <li>走らないで → ゆっくり歩こうね</li>
              <li>テレビを触らないで → 見るだけにしようね</li>
            </ul>
          </div>
          <p>または、今の状況を教えていただくと、その場に合ったやさしい言葉に言い換えることもできます。</p>
        </div>
      </div>
    <% end %>

    <%# 入力フォーム %>
    <%= render 'conversations/form', conversation: @conversation %>
  </div>
</div>
