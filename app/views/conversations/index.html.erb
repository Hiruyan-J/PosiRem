<%= content_for :title, "チャット画面" %>

<% if user_signed_in? %>
  <%= turbo_stream_from "user_#{current_user.id}" %>
<% end %>

<%= render 'shared/ai_error_messages', error_message: nil %>

<div class="container p-4 mx-auto">
  <div class="p-6 mx-auto max-w-2xl shadow-lg chat-container bg-base-100 rounded-box">
    <%# チャットメッセージ一覧 %>
    <div id="chat-messages"
          data-controller="infinite-scroll"
          data-infinite-scroll-url-value="<%= conversations_path %>"
          data-infinite-scroll-target="scrollContainer"
          style="overflow-anchor: none;"
          class="overflow-y-auto p-4 mb-4 space-y-4 max-h-[55vh] md:max-h-[60vh]">

      <% if @conversations.any? %>
        <%# 無限スクロール監視ポイント %>
        <div id="infinite-scroll-target" data-infinite-scroll-target="sentinel">
          <%= render "sentinel", message: "読み込み中…" %>
        </div>

        <%# 会話履歴を表示 %>
        <% @conversations.each do |conversation| %>
          <%= render "conversation", conversation: conversation %>
        <% end %>

      <% else %>
        <%# 無限スクロール監視ポイント %>
        <div id="infinite-scroll-target" data-infinite-scroll-target="sentinel">
          <%= render "sentinel", message: "" %>
        </div>

        <%# 初回説明メッセージ %>
        <%= render "onboarding_message" %>
      <% end %>
    </div>

    <%# 入力フォーム %>
    <%= render 'conversations/form', conversation: @conversation %>
  </div>
</div>
