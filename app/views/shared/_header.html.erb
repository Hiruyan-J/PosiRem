<header class="sticky top-0 z-50 py-2 px-2 font-bold tracking-tight shadow-sm md:px-4 navbar bg-secondary text-secondary-content">
  <!-- ハンバーガーメニュー -->
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /> </svg>
      </div>
      <ul
        tabindex="0"
        class="p-2 mt-3 w-52 shadow menu menu-md dropdown-content bg-base-200 text-base-content rounded-box z-1 md:menu-lg">
        <li><%= link_to "top", root_path %></li>
        <li><%= link_to "chat", conversations_path %></li>
      </ul>
    </div>
  </div>
  <!-- ロゴ表示 -->
  <div class="navbar-center">
    <%= link_to root_path, class: "p-0 btn btn-ghost btn-secondary" do %>
      <%= image_tag "header_logo.svg", alt: "PosiRem!", class: "w-auto h-12 md:h-14" %>
    <% end %>
  </div>
  <!-- ログイン・ログアウト -->
  <div class="navbar-end">
    <% unless user_signed_in? %>
      <!-- ログインボタン表示 -->
      <%= link_to new_user_session_path, class: "flex gap-1 items-center btn btn-ghost btn-secondary btn-md md:btn-lg" do %>
        <span><%= t('header.login') %></span>
        <span class="material-symbols-rounded ms-size-24 md:ms-size-32">login</span>
      <% end %>
    <% else %>
      <!-- ログアウトボタン表示 -->
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "flex gap-1 items-center btn btn-ghost btn-secondary btn-md md:btn-lg" do %>
        <span><%= t('header.logout') %></span>
        <span class="material-symbols-rounded ms-size-24 md:ms-size-32">logout</span>
      <% end %>
    <% end %>
  </div>
</header>
