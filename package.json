{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.9",
    "rustywind": "^0.24.3"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "tailwind:sort": "rustywind --write app/views/",
    "tailwind:check": "rustywind --check-formatted app/views/"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.16",
    "daisyui": "^5.1.12"
  }
}
